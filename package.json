{
  "name": "rave",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "bun --filter '*' run typecheck",
    "test": "bun --filter '*' run test",
    "daemon": "bun --filter daemon dev",
